# Presentation on a real Twilio number — copy to apps/telephony/.env
#   cp apps/telephony/.env.presentation.example apps/telephony/.env
# Then fill in the three TWILIO_ values and run: npm run present

# Twilio Console → Account → API keys & tokens
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=replace-me
# Your Twilio number, E.164 format
TWILIO_PHONE_NUMBER=+15551234567

# Demo mode: no FourPoints needed. Press 1 = language stream demo, press 2 = human interpreter.
PRESENTATION_MODE=true
# Languages read in the menu after "press 1" (max 9, in order).
PRESENTATION_LANGUAGES=Spanish,Mandarin,Arabic,French,Portuguese

# Pressing 2 rings this number and connects the caller (comma-separate to
# ring several at once; first to answer wins). Leave empty to only announce.
HUMAN_INTERPRETER_NUMBER=

PORT=8080
# PUBLIC_BASE_URL is set automatically by `npm run present`.
PUBLIC_BASE_URL=https://placeholder.invalid
