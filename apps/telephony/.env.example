# @fourpoints/telephony — copy to apps/telephony/.env (never commit .env)
# Run: node --env-file=apps/telephony/.env apps/telephony/dist/index.js

PORT=8080
# Public https origin Twilio reaches (no path). Must match the URLs in the Twilio Console.
PUBLIC_BASE_URL=https://phone.example.com

# Twilio Console → Account → API keys & tokens
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=replace-me
# Twilio API key (Console -> Account -> API keys), for the REST API. Needed
# only for ### during a human call -> AI (the gateway releases the
# interpreter's leg); unset, that switch is off. Needs outbound access to
# api.twilio.com.
# TWILIO_ACCOUNT_CLIENT_SID=SK00000000000000000000000000000000
# TWILIO_ACCOUNT_CLIENT_SECRET=replace-me
# Local experiments only; refused when NODE_ENV=production.
# TWILIO_VALIDATE_SIGNATURES=false

# --- FourPoints realtime -----------------------------------------------------
# Local FourPoints (npm run start:realtime, REQUIRE_AUTH unset) — works as-is:
FOURPOINTS_WS_URL=ws://localhost:8787
FOURPOINTS_AUTH=none
# Deployed FourPoints, once docs/fourpoints-exposure.md is in place:
# FOURPOINTS_WS_URL=wss://app.fourpointsls.com/ws/telephony
# FOURPOINTS_AUTH=client-credentials
# FOURPOINTS_TOKEN_URL=https://<cognito-domain>.auth.us-east-1.amazoncognito.com/oauth2/token
# FOURPOINTS_CLIENT_ID=
# FOURPOINTS_CLIENT_SECRET=
# FOURPOINTS_SCOPE=fourpoints-realtime/telephony.session

# --- Organization line (new number: organization ID, then access code) ------
# FourPoints control-plane API origin. Unset: /voice/org/* answers "not
# available"; the current number (/voice/incoming) is unaffected.
# FOURPOINTS_API_URL=https://staging.fourpointsls.com
# Scope for the API's phone routes (same machine client, its own token):
# FOURPOINTS_PHONE_SCOPE=fourpoints-internal/phone.resolve

# --- Conversation ------------------------------------------------------------
CLINICIAN_LANGUAGE_ID=en-US
# Optional: languages read out first (FourPoints language ids, comma-separated)
# Changing the order changes each language's key: regenerate the
# language-option clips in ivr-audio/ (until then those lines are <Say>).
# MENU_LANGUAGE_ORDER=es-US,zh-CN,ar-AE

# Recorded prompts (ivr-audio/final, made with ivr-audio/pipeline.mjs).
# Default: the bundled folder. Any line without a matching clip is a Twilio
# <Say>; PROMPTS_DIR=off makes every line a <Say> again.
# PROMPTS_DIR=/app/ivr-audio/final
# languageId → up to 10 E.164 numbers; "default" is required
HUMAN_INTERPRETER_NUMBERS='{"default":["+15555550100"],"es-US":["+15555550101"]}'

# --- Audio and capacity ------------------------------------------------------
# 16000 = the format the FourPoints browser client sends (tested path).
# 8000  = native phone audio; A/B per language before switching.
INPUT_SAMPLE_RATE_HZ=16000
# FourPoints checks which language each turn is in, so a party who keeps
# talking keeps their language (LANGID-001). Set false to turn it off.
DETECT_SPEAKER_LANGUAGE=true
# Concurrent AI calls on this instance; total capacity = instances × MAX_CALLS.
MAX_CALLS=20
# FourPoints ends sessions at 30 min; calls rotate to a fresh session before that.
SESSION_ROTATE_AFTER_MS=1680000
# VAD_MIN_RMS=0.015
# Silence (ms) that ends a caller's turn; raise it if pauses mid-sentence cut people off.
# VAD_HANGOVER_MS=1150
