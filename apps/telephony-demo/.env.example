# FourPoints phone line demo — optional settings
#
# The demo runs without this file. To change a setting:
#   Copy-Item apps\telephony-demo\.env.example apps\telephony-demo\.env
# then edit apps\telephony-demo\.env and restart `npm run demo`.
# `npm run demo` and `npm run demo:check` both read it at start-up.
#
# This file never needs real Twilio or AWS credentials.

# --- Ports ------------------------------------------------------------------
# Browser phone and Twilio emulator. Open http://localhost:<this port>.
DEMO_WEB_PORT=3000

# The telephony gateway (the real apps/telephony build).
DEMO_GATEWAY_PORT=8080

# The FourPoints stand-in. 8787 is also the real FourPoints realtime port:
# pick another (e.g. 8788) if a local FourPoints is running.
DEMO_FOURPOINTS_PORT=8787

# Where the stand-in listens. Keep 127.0.0.1 for the browser demo. Use 0.0.0.0
# only with `npm run demo:stand-in` when a gateway on another machine must reach it.
DEMO_FOURPOINTS_HOST=127.0.0.1

# --- Emulated Twilio identity -----------------------------------------------
# Unset = a new random identity every run (recommended). Set both to keep one
# fixed, e.g. to drive the gateway with the fake-twilio-call harness.
# The account SID must be "AC" followed by 32 hex characters.
# DEMO_TWILIO_ACCOUNT_SID=AC00000000000000000000000000000000
# DEMO_TWILIO_AUTH_TOKEN=local-demo-token

# --- Speech detection (passed to the gateway) -------------------------------
# How loud audio must be to count as speech. Default 0.015.
# Lower is more sensitive: try 0.008 for a quiet room or a distant microphone,
# 0.025 for a noisy room.
# VAD_MIN_RMS=0.015
