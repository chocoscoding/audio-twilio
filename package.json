{
  "name": "fourpoints-telephony-staging",
  "version": "0.0.1",
  "private": true,
  "description": "Staging workspace for @fourpoints/telephony. Mirrors the FourPoints monorepo layout so apps/telephony moves in unchanged.",
  "type": "module",
  "engines": {
    "node": ">=20.12"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "tsc -b",
    "start:telephony": "node apps/telephony/dist/index.js",
    "start:telephony:local": "node --env-file=apps/telephony/.env apps/telephony/dist/index.js",
    "present": "node scripts/present.mjs",
    "logs:twilio": "tail -n +1 -F logs/twilio.log",
    "logs:stream": "tail -n +1 -F logs/stream.log",
    "call:fake": "node apps/telephony/dist/fake-twilio-call.js",
    "check:protocol-sync": "node scripts/check-protocol-sync.mjs",
    "clean": "tsc -b --clean",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.0",
    "vitest": "^2.1.8"
  }
}
